# Anthropic API key. Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model ID used for every request. Optional, defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Passcode the streamer types on the login page.
APP_PASSCODE=change-me

# Random string used to sign the auth cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
